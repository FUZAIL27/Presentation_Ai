# Backend API base URL. In dev, Vite proxies /api to VITE_API_PROXY_TARGET (see vite.config.ts),
# so this can usually stay as the relative default below.
VITE_API_URL=/api/v1

# Only used by vite.config.ts's dev-server proxy target (not read by the app itself)
VITE_API_PROXY_TARGET=http://localhost:5000
